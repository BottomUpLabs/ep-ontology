    dmp:columnaOrigen "acta_entrega_fecha" ;
    dcterms:source "DMP regulacion_v1" .

:trasladoDireccionActa a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:string ;
    rdfs:label "direccion acta de traslado"@es ;
    skos:definition "Direccion destino segun acta de traslado"@es ;
    dmp:columnaOrigen "traslado_direccion_acta" ;
    dcterms:source "DMP regulacion_v1" .

:resolucionDireccionDefinitiva a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:string ;
    rdfs:label "direccion definitiva en resolucion"@es ;
    skos:definition "Direccion definitiva segun la ultima resolucion"@es ;
    dmp:columnaOrigen "resolucion_direccion_definitiva" ;
    dcterms:source "DMP regulacion_v1" .

# =============================================================================

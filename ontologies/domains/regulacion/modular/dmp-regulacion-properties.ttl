:visitaDomiciliariaNumero a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:integer ;
    rdfs:label "número de visita domiciliaria"@es ;
    skos:definition "Número secuencial de la visita domiciliaria"@es ;
    :formCampo "Nº" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaBarrio a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:string ;
    rdfs:label "barrio de la visita domiciliaria"@es ;
    skos:definition "Barrio donde se realizó la visita domiciliaria"@es ;
    :formCampo "BARRIO" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaComuna a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:string ;
    rdfs:label "comuna de la visita domiciliaria"@es ;
    skos:definition "Comuna donde se realizó la visita domiciliaria"@es ;
    :formCampo "COMUNA" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaEntregadoPor a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:string ;
    rdfs:label "entregado por"@es ;
    skos:definition "Funcionario que entregó el registro de la visita"@es ;
    :formCampo "ENTREGADO POR" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaHoraInicio a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:time ;
    rdfs:label "hora de inicio"@es ;
    skos:definition "Hora de inicio de la visita domiciliaria"@es ;
    :formCampo "HORA DE INICIO" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaHoraFin a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:time ;
    rdfs:label "hora de finalización"@es ;
    skos:definition "Hora de finalización de la visita domiciliaria"@es ;
    :formCampo "HORA DE FINALIZACION" ;
    :formFormulario "FO-GGOL-028" .

:visitaDomiciliariaObservaciones a owl:DatatypeProperty ;
    rdfs:domain :VisitaDomiciliaria ;
    rdfs:range xsd:string ;
    rdfs:label "observaciones de la visita domiciliaria"@es ;
    skos:definition "Observaciones registradas durante la visita domiciliaria"@es ;
    :formCampo "OBSERVACIONES" ;
    :formFormulario "FO-GGOL-028" .


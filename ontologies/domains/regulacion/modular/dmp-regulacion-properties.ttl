    skos:definition "Fecha de emision del concepto tecnico en APP"@es ;
    dmp:columnaOrigen "concepto_tecnico_app_fecha" ;
    dmp:ruleName "format_iso_date" ;
    dcterms:source "DMP regulacion_v1" .

:facturacionEnvioFecha a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:date ;
    rdfs:label "fecha envio a facturacion"@es ;
    skos:definition "Fecha en que se envio informacion a facturacion"@es ;
    dmp:columnaOrigen "facturacion_envio_fecha" ;
    dmp:ruleName "format_iso_date" ;
    dcterms:source "DMP regulacion_v1" .

:retribucionValor a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:decimal ;
    rdfs:label "valor de retribucion"@es ;
    skos:definition "Valor de retribucion economica a pagar"@es ;
    dmp:columnaOrigen "retribucion_valor" ;
    dmp:ruleName "format_moneda_colombiana" ;
    dcterms:source "DMP regulacion_v1" .

# =============================================================================
# PROPIEDADES DE DATOS: Visitas
# =============================================================================

:visitaAdministrativa1Fecha a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:date ;
    rdfs:label "fecha primera visita administrativa"@es ;
    skos:definition "Fecha de la primera visita administrativa de seguimiento"@es ;
    dmp:columnaOrigen "visita_administrativa_1_fecha" ;
    dcterms:source "DMP regulacion_v1" .

:visitaAdministrativa2Fecha a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:date ;
    rdfs:label "fecha segunda visita administrativa"@es ;
    skos:definition "Fecha de la segunda visita administrativa de seguimiento"@es ;
    dmp:columnaOrigen "visita_administrativa_2_fecha" ;
    dcterms:source "DMP regulacion_v1" .

:visitaAdministrativa3Fecha a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:date ;
    rdfs:label "fecha tercera visita administrativa"@es ;
    skos:definition "Fecha de la tercera visita administrativa de seguimiento"@es ;
    dmp:columnaOrigen "visita_administrativa_3_fecha" ;
    dcterms:source "DMP regulacion_v1" .

:estudioSocioeconomicoFecha a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:date ;
    rdfs:label "fecha estudio socioeconomico"@es ;
    skos:definition "Fecha del ultimo estudio socioeconomico realizado"@es ;
    dmp:columnaOrigen "estudio_socioeconomico_fecha" ;

@prefix : <https://w3id.org/medellin/espacio-publico/regulacion#> .
@prefix core: <https://w3id.org/medellin/espacio-publico/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dmp: <https://w3id.org/medellin/espacio-publico/dmp#> .
@prefix iso11179: <http://purl.org/iso11179/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .

# =============================================================================
# Ontologia Modular: Propiedades Derivadas del DMP regulacion_v1
# =============================================================================
# Fecha creacion: 2026-01-07
# Descripcion: Define propiedades para VendedorInformalRegulado, PuestoVenta,
#              Modulo y Visita basadas en el estandar DMP regulacion_v1.
#              Este modulo NORMALIZA la estructura columnar del DMP a una
#              estructura orientada a objetos semanticos.
#
# Secciones DMP mapeadas:
#   - Titular (36 columnas) → PersonaNatural + VendedorInformalRegulado
#   - Puesto (31 columnas)  → PuestoVenta + LugarVenta + Modulo
#   - Estado (12 columnas)  → Estado del ciclo de vida
#   - Resoluciones (64 columnas) → PermisoOcupacionTemporal (normalizado por año)
#   - Servicios (5 columnas) → Modulo.tieneServicio
#   - APP (4 columnas) → ConceptoTecnico + Facturacion
#   - Visitas (3 columnas) → VisitaAdministrativa
#   - Sistema (2 columnas) → Metadatos internos (item_id)
# =============================================================================

<https://w3id.org/medellin/espacio-publico/regulacion/dmp-regulacion-properties> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/medellin/espacio-publico/regulacion/dmp-regulacion-properties/0.1.0> ;
    dcterms:publisher <https://w3id.org/medellin/espacio-publico/agent/subsecretaria-espacio-publico> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:issued "2026-05-31"^^xsd:date ;
    bibo:status "published"@en ;
    owl:imports <https://w3id.org/medellin/espacio-publico/core/institutional-core-entities> ;
    dcterms:title "Espacio Publico - Propiedades DMP Regulacion"@es ;
    dcterms:description """Ontologia que define propiedades de datos derivadas del 
    estandar DMP regulacion_v1. Normaliza la estructura columnar orientada a años
    hacia una estructura semantica orientada a objetos."""@es ;
    dcterms:source "DMP regulacion_v1 - main_metadata.dmp_a1_diccionario" ;
    dcterms:created "2026-01-07"^^xsd:date ;
    dcterms:modified "2026-01-07"^^xsd:date ;
    owl:versionInfo "0.1.0" .



# =============================================================================
# CLASE: VisitaAdministrativa (FO-GGOL-036 - Visita al Puesto de Venta)
# =============================================================================
# Formulario: FO-GGOL-036 v6 "Visita administrativa a ventas informales"
# Se realiza EN EL PUESTO DE VENTA para verificar cumplimiento de obligaciones.
# =============================================================================

:VisitaAdministrativa a owl:Class ;
    rdfs:subClassOf core:Evento ;
    rdfs:label "Visita Administrativa"@es ;
    rdfs:label "Administrative Visit"@en ;
    skos:prefLabel "Visita Administrativa"@es ;
    skos:altLabel "Visita de campo"@es ;
    skos:altLabel "Visita al puesto de venta"@es ;
    skos:definition """Visita realizada por funcionarios de la Subsecretaría AL PUESTO DE VENTA 
    del vendedor informal para verificar cumplimiento de obligaciones, condiciones de operación 
    y detectar novedades. Se captura mediante FO-GGOL-036.
    
    Finalidades según FO-GGOL-036:
    - Verificación: Comprobar cumplimiento de condiciones autorizadas
    - Novedad: Documentar cambios o irregularidades detectadas
    
    Origen de la visita:
    - Oficio, Solicitud del interesado, PQRS, Autoridad judicial, Programa de reubicaciones"""@es ;
    skos:scopeNote """Secciones del FO-GGOL-036:
    1. VENTERO INFORMAL: Datos personales y estado (regulado/en trámite)
    2. DATOS DE LA VENTA: Ubicación, horario, actividad autorizada
    3. DATOS DEL AMOBLAMIENTO: Tipo, propiedad, medidas, servicios públicos
    4. SEGUIMIENTO Y CONTROL: Verificación de cumplimiento
    5. NOVEDAD ADMINISTRATIVA: Novedades detectadas
    6. OBSERVACIONES: Comentarios adicionales
    7. REGISTRO FOTOGRÁFICO: Evidencia visual"""@es ;
    dcterms:source "FO-GGOL-036 v6" ;
    :formularioAsociado "FO-GGOL-036" ;
    iso11179:objectClass "Visita_Administrativa" .

# =============================================================================
# CLASE: VisitaDomiciliaria (FO-GGOL-028 - Visita al Domicilio)
# =============================================================================
# Formulario: FO-GGOL-028 v3 "Visitas Domiciliarias Realizadas en Campo"
# Se realiza EN LA VIVIENDA del vendedor para verificar condiciones de vida.
# =============================================================================

:VisitaDomiciliaria a owl:Class ;
    rdfs:subClassOf core:Evento ;
    rdfs:label "Visita Domiciliaria"@es ;
    rdfs:label "Home Visit"@en ;
    skos:prefLabel "Visita Domiciliaria"@es ;
    skos:altLabel "Visita al domicilio"@es ;
    skos:altLabel "Visita de campo domiciliaria"@es ;
    skos:definition """Visita realizada por funcionarios A LA VIVIENDA del vendedor informal 
    para verificar condiciones de vida, composición familiar y situación socioeconómica 
    como parte del proceso de estudio socioeconómico. Se captura mediante FO-GGOL-028."""@es ;
    skos:scopeNote """La visita domiciliaria es un insumo para el EstudioSocioeconomico (FO-GOOL-044)
    y complementa la información recopilada en el ConceptoVulnerabilidad (FO-GGOL-016).
    
    Diferencia con VisitaAdministrativa:
    - VisitaDomiciliaria: Se realiza EN LA VIVIENDA del vendedor
    - VisitaAdministrativa: Se realiza EN EL PUESTO DE VENTA"""@es ;
    dcterms:source "FO-GGOL-028 v3" ;
    :formularioAsociado "FO-GGOL-028" ;
    iso11179:objectClass "Visita_Domiciliaria" .

# -----------------------------------------------------------------------------
# Propiedades: VisitaDomiciliaria (FO-GGOL-028)

# =============================================================================
# PROPIEDADES DE DATOS: VisitaAdministrativa (Detalle de Visita)
# =============================================================================

:numeroVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:integer ;
    rdfs:label "número de visita"@es ;
    skos:definition "Número secuencial de la visita administrativa (1, 2, 3...)"@es ;
    skos:scopeNote "Las visitas 1-3 son de seguimiento regular; visitas adicionales pueden ser por novedad"@es .

:fechaVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:date ;
    rdfs:label "fecha de visita"@es ;
    skos:definition "Fecha en que se realizó la visita administrativa"@es .

:tipoVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:string ;
    rdfs:label "tipo de visita"@es ;
    skos:definition "Tipo de visita: 'seguimiento', 'novedad', 'estudio_socioeconomico', 'verificacion'"@es .

:resultadoVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:string ;
    rdfs:label "resultado de visita"@es ;
    skos:definition "Resultado de la visita: 'conforme', 'novedad_detectada', 'ausente', 'puesto_cerrado'"@es .

:funcionarioVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:string ;
    rdfs:label "funcionario que realizó la visita"@es ;
    skos:definition "Nombre del funcionario o profesional que realizó la visita"@es .

:observacionesVisita a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:string ;
    rdfs:label "observaciones de visita"@es ;
    skos:definition "Observaciones registradas durante la visita administrativa"@es .

:visitaGeneraNovedad a owl:ObjectProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range :Novedad ;
    rdfs:label "visita genera novedad"@es ;
    skos:definition "Vincula la visita a la novedad que detectó (si aplica)"@es .

:visitaActualizaEstado a owl:DatatypeProperty ;
    rdfs:domain :VisitaAdministrativa ;
    rdfs:range xsd:boolean ;
    rdfs:label "visita actualiza estado"@es ;
    skos:definition "Indica si la visita generó un cambio de estado del vendedor"@es .

# =============================================================================
# PROPIEDADES DE DATOS: Sistema
# =============================================================================

:itemId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:string ;
    rdfs:label "ID de registro"@es ;
    skos:definition "Identificador unico del registro en el sistema fuente"@es ;
    dmp:columnaOrigen "item_id" ;
    dcterms:source "DMP regulacion_v1" .

:observacionesAdicionales a owl:DatatypeProperty ;
    rdfs:domain :VendedorInformalRegulado ;
    rdfs:range xsd:string ;
    rdfs:label "observaciones adicionales"@es ;
    skos:definition "Observaciones generales adicionales del registro"@es ;
    dmp:columnaOrigen "observaciones_adicionales" ;
    dcterms:source "DMP regulacion_v1" .

# =============================================================================
# ANNOTATION PROPERTY: Trazabilidad DMP
# =============================================================================

dmp:columnaOrigen a owl:AnnotationProperty ;
    rdfs:label "columna DMP origen"@es ;
    skos:definition "Nombre de la columna en el DMP a1_diccionario de origen"@es .

dmp:estandarOrigen a owl:AnnotationProperty ;
    rdfs:label "estandar DMP origen"@es ;
    skos:definition "Identificador del estandar DMP de origen (ej: regulacion_v1)"@es .

dmp:ruleName a owl:DatatypeProperty ;
    rdfs:label "nombre de regla de calidad"@es ;
    rdfs:label "quality rule name"@en ;
    rdfs:range xsd:string ;
    skos:definition "Nombre de la regla de validacion de calidad (vocabulario o formato) aplicable a esta propiedad, segun rule-names-vocabulary.ttl"@es .


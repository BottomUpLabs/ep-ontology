# =============================================================================
# CLASE: EstudioSocioeconomico (FO-GOOL-044 - Documento Completo)
# =============================================================================
# NOTA: El EstudioSocioeconomico completo con propiedades del FO-GOOL-044
# está definido en estudio-socioeconomico.ttl
# =============================================================================

:EstudioSocioeconomico a owl:Class ;
    rdfs:subClassOf core:ConceptoTecnico ;
    rdfs:label "Estudio Socioeconomico"@es ;
    rdfs:label "Socioeconomic Study"@en ;
    skos:prefLabel "Estudio Socioeconomico"@es ;
    skos:altLabel "Concepto Socioeconómico"@es ;
    skos:altLabel "FO-GGOL-016"@es ;
    skos:historyNote "Corregido 2026-01: rdfs:subClassOf cambiado de :VisitaAdministrativa a core:ConceptoTecnico - el estudio es un documento de evaluación, no una visita"@es ;
    skos:definition """Documento formal que registra el resultado de la evaluación de vulnerabilidad
    de un vendedor informal. Es el producto del ConceptoVulnerabilidad (concepto técnico) y se
    captura mediante el formulario FO-GGOL-016. Incluye:
    - Criterios de inclusión (SISBÉN, protección constitucional, víctima, discapacidad, etc.)
    - Valoración económica (puntaje SISBÉN, clasificación, grado vulnerabilidad, línea pobreza)
    - Evaluación profesional (profesional social, fecha, concepto)
    
    El estudio soporta la decisión de otorgar PermisoOcupacionTemporal y determina si el 
    beneficiario es exento de retribución económica."""@es ;
    skos:scopeNote """Ciclo de vida:
    1. ConceptoVulnerabilidad (concepto técnico) se crea para el trámite
    2. Profesional social realiza visita y diligencia FO-GGOL-016
    3. Se genera EstudioSocioeconomico como registro formal
    4. Si resultado favorable → soporta AprobacionPermiso"""@es ;
    dcterms:source "DMP regulacion_v1 - estudio_socioeconomico_fecha, FO-GGOL-016 v8" ;
    :formularioAsociado "FO-GGOL-016" ;
    :metodologiaReferencia "DE-GGOL-007" ;
    dmp:columnaOrigen "estudio_socioeconomico_fecha" .

# =============================================================================
# PROPIEDADES DE DATOS: Modulo
# =============================================================================

# =============================================================================
# NOTA: Las propiedades básicas de Modulo (numeroModulo, materialModulo, etc.)
# están definidas en infraestructura.ttl. Aquí solo se definen propiedades 
# adicionales con trazabilidad DMP.
# =============================================================================

:moduloPlaca a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:string ;
    rdfs:label "placa del modulo"@es ;
    skos:definition "Placa de identificacion oficial del modulo"@es ;
    dmp:columnaOrigen "puesto_modulo_placa" ;
    dcterms:source "DMP regulacion_v1" .

:moduloTipo a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:string ;
    rdfs:label "tipo de modulo"@es ;
    skos:definition "Tipologia del modulo (kiosco, caseta, carpa, etc.)"@es ;
    dmp:columnaOrigen "modulo_tipo" ;
    dcterms:source "DMP regulacion_v1" .

# --- Servicios del Modulo ---

:tieneServicioAgua a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:boolean ;
    rdfs:label "tiene servicio de agua"@es ;
    skos:definition "Indica si el modulo cuenta con servicio de agua potable"@es ;
    dmp:columnaOrigen "servicios_agua_indicador" ;
    dmp:ruleName "format_boolean" ;
    dcterms:source "DMP regulacion_v1" .

:tieneServicioAlcantarillado a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:boolean ;
    rdfs:label "tiene alcantarillado"@es ;
    skos:definition "Indica si el modulo cuenta con conexion a alcantarillado"@es ;
    dmp:columnaOrigen "servicios_alcantarillado_indicador" ;
    dmp:ruleName "format_boolean" ;
    dcterms:source "DMP regulacion_v1" .

:tieneServicioEnergia a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:boolean ;
    rdfs:label "tiene servicio de energia"@es ;
    skos:definition "Indica si el modulo cuenta con energia electrica"@es ;
    dmp:columnaOrigen "servicios_energia_indicador" ;
    dmp:ruleName "format_boolean" ;
    dcterms:source "DMP regulacion_v1" .

:tieneServicioGas a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:boolean ;
    rdfs:label "tiene servicio de gas"@es ;
    skos:definition "Indica si el modulo cuenta con conexion de gas"@es ;
    dmp:columnaOrigen "servicios_gas_indicador" ;
    dcterms:source "DMP regulacion_v1" .

:tieneServiciosPublicos a owl:DatatypeProperty ;
    rdfs:domain :Modulo ;
    rdfs:range xsd:boolean ;
    rdfs:label "tiene servicios publicos"@es ;
    skos:definition "Indicador general de disponibilidad de servicios publicos"@es ;
    dmp:columnaOrigen "servicios_publicos_indicador" ;
    dcterms:source "DMP regulacion_v1" .


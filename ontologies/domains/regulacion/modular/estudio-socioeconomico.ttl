# =============================================================================
# SHACL SHAPES: Validación del Estudio
# =============================================================================

:EstudioSocioeconomicoShape a sh:NodeShape ;
    sh:targetClass :EstudioSocioeconomicoCompleto ;
    rdfs:label "Shape para Estudio Socioeconómico"@es ;
    sh:description "Valida campos mínimos requeridos del FO-GOOL-044"@es ;
    
    sh:property [
        sh:path :estudioNumeroIdentificacion ;
        sh:minCount 1 ;
        sh:message "El estudio debe incluir número de identificación del solicitante"@es
    ] ;
    
    sh:property [
        sh:path :estudioPoseeSisben ;
        sh:minCount 1 ;
        sh:message "Debe indicarse si posee SISBÉN"@es
    ] ;
    
    sh:property [
        sh:path :estudioTotalIngresos ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Debe registrarse el total de ingresos familiares"@es
    ] ;
    
    sh:property [
        sh:path :estudioTotalGastos ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Debe registrarse el total de gastos familiares"@es
    ] .

# =============================================================================

:MiembroGrupoFamiliar a owl:Class ;
    rdfs:label "Miembro del Grupo Familiar"@es ;
    skos:prefLabel "Miembro del Grupo Familiar"@es ;
    skos:definition """Cada persona que compone el grupo familiar del vendedor informal,
    según la sección 9 del FO-GOOL-044."""@es ;
    dcterms:source "FO-GOOL-044 - INFORMACIÓN GENERAL DEL GRUPO FAMILIAR" .

:miembroOrden a owl:DatatypeProperty ;
    rdfs:domain :MiembroGrupoFamiliar ;

# =============================================================================
# SECCIÓN 8: CUESTIONARIO APGAR
# =============================================================================

:estudioPuntajeAPGAR a owl:DatatypeProperty ;
    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range xsd:integer ;
    rdfs:label "puntaje total APGAR"@es ;
    skos:definition """Puntaje total del cuestionario APGAR familiar (0-10).
    7-10: Familia altamente funcional
    4-6: Familia moderadamente funcional
    0-3: Familia severamente disfuncional"""@es ;
    form:campo "Puntaje total cuestionario APGAR" ;
    form:seccion "CUESTIONARIO APGAR" ;
    form:formulario "FO-GOOL-044" .


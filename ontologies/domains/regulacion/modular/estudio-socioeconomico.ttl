# =============================================================================
# Ontología Modular: Estudio Socioeconómico (FO-GOOL-044)
# =============================================================================
# Fecha creación: 2026-01-07
# Descripción: Define el Estudio Socioeconómico completo capturado mediante el 
#              formulario FO-GOOL-044 v9. Este estudio es el insumo principal
#              para el ConceptoVulnerabilidad (FO-GGOL-016) y junto con el 
#              ConceptoCruceInterinstitucional (FO-GGOL-022) fundamenta el
#              PermisoOcupacionTemporal.
#
# Formulario: FO-GOOL-044 v9 "Estudio Socioeconómico"
# Secciones: 9
# Campos: 145
# =============================================================================

<https://w3id.org/medellin/espacio-publico/regulacion/estudio-socioeconomico> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/medellin/espacio-publico/regulacion/estudio-socioeconomico/0.1.0> ;
    dcterms:publisher <https://w3id.org/medellin/espacio-publico/agent/subsecretaria-espacio-publico> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:issued "2026-05-31"^^xsd:date ;
    bibo:status "published"@en ;
    dcterms:title "Espacio Público - Estudio Socioeconómico"@es ;
    dcterms:description """Ontología que define el Estudio Socioeconómico (FO-GOOL-044 v9)
    para vendedores informales. Es el documento más completo de caracterización 
    socioeconómica y familiar del solicitante.
    
    FLUJO EN EL PROCESO:
    1. VisitaDomiciliaria (FO-GGOL-028) - Visita al domicilio del vendedor
    2. EstudioSocioeconomico (FO-GOOL-044) - Caracterización completa
    3. ConceptoVulnerabilidad (FO-GGOL-016) - Concepto técnico resumen
    4. ConceptoCruceInterinstitucional (FO-GGOL-022) - Verificación bases de datos
    5. PermisoOcupacionTemporal - Autorización final
    
    Secciones del formulario:
    1. DATOS PERSONALES
    2. CRITERIOS DE INCLUSIÓN
    3. ASPECTOS DE LA VIVIENDA
    4. ASPECTOS DE SEGURIDAD SOCIAL
    5. ASPECTOS ECONÓMICOS
    6. ASPECTOS POBLACIONALES
    7. ASPECTOS FAMILIARES
    8. CUESTIONARIO APGAR (funcionalidad familiar)
    9. INFORMACIÓN GENERAL DEL GRUPO FAMILIAR"""@es ;
    dcterms:created "2026-01-07"^^xsd:date ;
    dcterms:modified "2026-01-07"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    vann:preferredNamespacePrefix "reg" ;
    vann:preferredNamespaceUri "https://w3id.org/medellin/espacio-publico/regulacion#" ;
    dcterms:source "FO-GOOL-044 v9" ;
    owl:imports <https://w3id.org/medellin/espacio-publico/regulacion/tramites-autorizacion> .

# =============================================================================
# CLASE: EstudioSocioeconomico
# =============================================================================

:EstudioSocioeconomicoCompleto a owl:Class ;
    rdfs:label "Estudio Socioeconómico Completo"@es ;
    rdfs:label "Complete Socioeconomic Study"@en ;
    skos:prefLabel "Estudio Socioeconómico"@es ;
    skos:altLabel "FO-GOOL-044"@es ;
    skos:altLabel "Caracterización Socioeconómica"@es ;
    skos:definition """Documento de caracterización socioeconómica integral del vendedor 
    informal y su núcleo familiar. Es el instrumento más completo para evaluar la 
    vulnerabilidad y elegibilidad del solicitante. Se captura mediante FO-GOOL-044 v9.
    
    El estudio incluye:
    - Datos personales y de identificación
    - Criterios de inclusión (SISBÉN, protección constitucional, etc.)
    - Condiciones de vivienda
    - Seguridad social (EPS, pensión, SISBÉN)
    - Situación económica (ingresos, gastos, balance)
    - Aspectos poblacionales (grupos étnicos, discapacidad, desplazamiento)
    - Composición y funcionalidad familiar (APGAR)
    - Información detallada de cada miembro del grupo familiar"""@es ;
    skos:scopeNote """Este estudio es el insumo principal para:
    1. ConceptoVulnerabilidad (FO-GGOL-016) - Resumen ejecutivo
    2. Determinación de grado de vulnerabilidad (1-5)
    3. Decisión de exención de retribución económica
    
    Requiere visita domiciliaria previa (FO-GGOL-028)."""@es ;
    dcterms:source "FO-GOOL-044 v9" ;
    :formularioAsociado "FO-GOOL-044" .

# =============================================================================
# PROPIEDADES DE OBJETO: Relaciones con el Flujo
# =============================================================================

:estudioParaSolicitud a owl:ObjectProperty ;
    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range :SolicitudAutorizacionTemporal ;
    rdfs:label "estudio para solicitud"@es ;
    skos:definition "Vincula el estudio socioeconómico a la solicitud de autorización que fundamenta"@es .

:estudioGeneraConcepto a owl:ObjectProperty ;
    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range :ConceptoVulnerabilidad ;
    rdfs:label "genera concepto"@es ;
    skos:definition "Vincula el estudio al ConceptoVulnerabilidad que genera"@es .

:requiereVisitaDomiciliaria a owl:ObjectProperty ;
    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range :VisitaDomiciliaria ;
    rdfs:label "requiere visita domiciliaria"@es ;
    skos:definition "Vincula el estudio a la visita domiciliaria previa requerida"@es .

:tieneGrupoFamiliar a owl:ObjectProperty ;
    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range :MiembroGrupoFamiliar ;
    rdfs:label "tiene grupo familiar"@es ;
    skos:definition "Vincula el estudio a los miembros del grupo familiar registrados"@es .


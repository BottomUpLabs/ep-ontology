    rdfs:domain :EstudioSocioeconomicoCompleto ;
    rdfs:range xsd:string ;
    rdfs:label "nivel de funcionalidad familiar"@es ;
    skos:definition "Clasificación de funcionalidad familiar según APGAR"@es ;
    skos:scopeNote """
    - Altamente funcional (7-10 puntos)
    - Moderadamente funcional (4-6 puntos)
    - Severamente disfuncional (0-3 puntos)"""@es ;
    form:formulario "FO-GOOL-044" .

# =============================================================================

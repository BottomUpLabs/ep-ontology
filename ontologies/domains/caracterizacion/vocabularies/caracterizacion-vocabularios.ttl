# --- SEXO (Gender) ---

epd-car-vocab:SexoScheme
    a skos:ConceptScheme ;
    dct:publisher <https://w3id.org/medellin/espacio-publico/agent/subsecretaria-espacio-publico> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-05-31"^^xsd:date ;
    bibo:status "published"@en ;
    skos:prefLabel "Sexo del Vendedor"@es ;
    dct:title "Clasificación de Sexo - DANE"@es ;
    dct:description "Valores de sexo según DANE"@es ;
    dct:source "DMP a2_listas - sexo" ;
    dct:created "2026-01-11"^^xsd:date ;
    dct:modified "2026-01-11"^^xsd:date ;
    rdfs:comment "Clasificación estandarizada DANE para sexo o género"@es ;
    owl:versionInfo "0.1.0" .

epd-car-vocab:masculino
    a skos:Concept ;
    skos:inScheme epd-car-vocab:SexoScheme ;
    skos:prefLabel "Masculino"@es ;
    skos:notation "M" ;
    skos:hiddenLabel "hombre"@es ;
    skos:hiddenLabel "var"@es ;
    dct:source "DANE" ;
    skos:topConceptOf epd-car-vocab:SexoScheme .

epd-car-vocab:femenino
    a skos:Concept ;
    skos:inScheme epd-car-vocab:SexoScheme ;
    skos:prefLabel "Femenino"@es ;
    skos:notation "F" ;
    skos:hiddenLabel "mujer"@es ;
    skos:hiddenLabel "fem"@es ;
    dct:source "DANE" ;
    skos:topConceptOf epd-car-vocab:SexoScheme .

epd-car-vocab:otro
    a skos:Concept ;
    skos:inScheme epd-car-vocab:SexoScheme ;
    skos:prefLabel "Otro"@es ;
    skos:notation "O" ;
    skos:hiddenLabel "no binario"@es ;
    dct:source "DANE" ;
    skos:topConceptOf epd-car-vocab:SexoScheme .


# --- ACTIVIDAD ECONOMICA ---

epd-car-vocab:ActividadEconomicaScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Actividad Económica de Vendedor"@es ;
    dct:title "Clasificación de Actividades Económicas Informales"@es ;
    dct:source "DMP a2_listas - actividad_economica_tipologica" ;
    dct:created "2026-01-11"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "Clasificación de tipos de venta/comercio realizados por vendedores informales"@es .

epd-car-vocab:ventaAlimentos
    a skos:Concept ;
    skos:inScheme epd-car-vocab:ActividadEconomicaScheme ;
    skos:prefLabel "Venta y consumo de alimentos y bebidas no alcohólicas"@es ;
    skos:notation "ALI" ;
    skos:altLabel "Venta de Alimentos"@es ;
    skos:hiddenLabel "alimentos"@es ;
    skos:hiddenLabel "comidas"@es ;
    skos:hiddenLabel "arepas"@es ;
    skos:hiddenLabel "comida rápida"@es ;
    skos:definition "Comercialización de alimentos preparados, bebidas, refrescos"@es ;
    skos:example "Vendedor de arepas, jugos, empanadas, comida callejera"@es ;
    skos:topConceptOf epd-car-vocab:ActividadEconomicaScheme ;
    dct:source "Clasificación interna" .

epd-car-vocab:comercializacionBienes
    a skos:Concept ;
    skos:inScheme epd-car-vocab:ActividadEconomicaScheme ;
    skos:prefLabel "Comercialización de bienes"@es ;
    skos:notation "BIE" ;
    skos:altLabel "Venta de Productos"@es ;
    skos:hiddenLabel "ropa"@es ;
    skos:hiddenLabel "accesorios"@es ;
    skos:hiddenLabel "mercancia"@es ;
    skos:definition "Venta de productos y mercancías (ropa, accesorios, artesanías, etc.)"@es ;
    skos:example "Vendedor de ropa usada, accesorios de moda, artesanías"@es ;
    skos:topConceptOf epd-car-vocab:ActividadEconomicaScheme ;
    dct:source "Clasificación interna" .

epd-car-vocab:servicios
    a skos:Concept ;
    skos:inScheme epd-car-vocab:ActividadEconomicaScheme ;
    skos:prefLabel "Prestación de servicios"@es ;
    skos:notation "SER" ;
    skos:altLabel "Servicios"@es ;
    skos:hiddenLabel "reparacion"@es ;
    skos:hiddenLabel "limpieza"@es ;
    skos:hiddenLabel "belleza"@es ;
    skos:definition "Prestación de servicios (reparación, peluquería, servicios de aseo, etc.)"@es ;
    skos:example "Peluquero, reparador de electrodomésticos, sastre, servicio de aseó"@es ;
    skos:topConceptOf epd-car-vocab:ActividadEconomicaScheme ;
    dct:source "Clasificación interna" .

epd-car-vocab:artesanias
    a skos:Concept ;
    skos:inScheme epd-car-vocab:ActividadEconomicaScheme ;
    skos:prefLabel "Artesanías y oficios"@es ;
    skos:notation "ART" ;
    skos:hiddenLabel "artesania"@es ;
    skos:hiddenLabel "manualidades"@es ;
    skos:definition "Elaboración y venta de artesanías y productos de oficios tradicionales"@es ;
    skos:example "Alfarero, tejedor, ebanista informal"@es ;
    skos:topConceptOf epd-car-vocab:ActividadEconomicaScheme ;
    dct:source "Clasificación interna" .

epd-car-vocab:entretenimiento
    a skos:Concept ;
    skos:inScheme epd-car-vocab:ActividadEconomicaScheme ;
    skos:prefLabel "Entretenimiento y ocio"@es ;
    skos:notation "ENT" ;
    skos:hiddenLabel "música"@es ;
    skos:hiddenLabel "juegos"@es ;
    skos:hiddenLabel "payaso"@es ;
    skos:definition "Servicios de entretenimiento, música, juegos"@es ;
    skos:example "Músico callejero, mago, payaso, vendedor de juegos"@es ;
    skos:topConceptOf epd-car-vocab:ActividadEconomicaScheme ;
    dct:source "Clasificación interna" .


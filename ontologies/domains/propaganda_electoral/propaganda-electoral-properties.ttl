    pe:semanticLayer "identifiers" ;
    pe:semanticType "file_reference" ;
    pe:columnaOrigen "archivo_formulario_e6" .

pep:ubicacionFoto a owl:DatatypeProperty ;
    rdfs:label "foto de ubicacion"@es ;
    rdfs:domain pe:ElementoPublicitario ;
    rdfs:range xsd:string ;
    skos:prefLabel "foto ubicacion"@es ;
    skos:definition "Ruta a la foto de la ubicacion de instalacion"@es ;
    pe:semanticLayer "identifiers" ;
    pe:semanticType "file_reference" ;
    pe:columnaOrigen "ubicacion_instalacion_foto" .

pep:infraccionFoto a owl:DatatypeProperty ;
    rdfs:label "foto de evidencia"@es ;
    rdfs:domain pe:InfraccionElectoral ;
    rdfs:range xsd:string ;
    skos:prefLabel "foto evidencia"@es ;

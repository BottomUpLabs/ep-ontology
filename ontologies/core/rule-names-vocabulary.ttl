@prefix : <https://w3id.org/medellin/espacio-publico/core/rule-names#> .
@prefix rn: <https://w3id.org/medellin/espacio-publico/core/rule-names#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .

# =============================================================================
# ONTOLOGIA: Rule Names Vocabulary - Espacio Publico
# =============================================================================
# SKOS Vocabulary of valid rule names for DMP quality enforcement.
# Generated automatically from metadata_sys master tables and dmp_tentative.
#
# Rule Types:
#   - vocab_{name}: Controlled vocabulary rules (a2_listas)
#   - format_{name}: Syntactic format rules (a3_formatos)
#   - regulacion_vocab_{name}: Vocabulary rules from regulacion_v1 DMP tentative
#   - regulacion_format_{name}: Format rules from regulacion_v1 DMP tentative
# =============================================================================

<https://w3id.org/medellin/espacio-publico/core/rule-names> a owl:Ontology, skos:ConceptScheme ;
    owl:versionIRI <https://w3id.org/medellin/espacio-publico/core/rule-names/0.1.0> ;
    dcterms:publisher <https://w3id.org/medellin/espacio-publico/agent/subsecretaria-espacio-publico> ;
    dcterms:issued "2026-05-31"^^xsd:date ;
    bibo:status "published"@en ;
    dcterms:title "DMP Rule Names Vocabulary"@es ;
    dcterms:title "DMP Rule Names Vocabulary"@en ;
    dcterms:description """Vocabulario controlado de nombres de reglas para el sistema
    de gestion de calidad de datos (DMP). Incluye reglas de vocabulario controlado
    (vocab_*) y reglas de formato sintactico (format_*), asi como reglas especificas
    para el procedimiento de regulacion de vendedores informales (regulacion_*).
    
    Este archivo se genera automaticamente desde las tablas maestras:
    - main_metadata.controlled_vocabulary_list
    - main_metadata.syntactic_format_type
    - data/dmp_tentative/a2/regulacion_v1_dmp_a2_listas.csv
    - data/dmp_tentative/a3/regulacion_v1_dmp_a3_formatos.csv"""@es ;
    dcterms:creator "Subsecretaria de Espacio Publico - Secretaria de Seguridad y Convivencia" ;
    dcterms:created "2026-01-09"^^xsd:date ;
    dcterms:modified "2026-01-09"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" ;
    skos:hasTopConcept :VocabularyRule, :FormatRule, :RegulacionVocabularyRule, :RegulacionFormatRule .

# =============================================================================
# TOP CONCEPTS: Rule Type Categories
# =============================================================================

:VocabularyRule a skos:Concept ;
    skos:prefLabel "Vocabulary Rule"@en ;
    skos:prefLabel "Regla de Vocabulario"@es ;
    skos:definition "Rule that validates values against a controlled vocabulary list"@en ;
    skos:definition "Regla que valida valores contra una lista de vocabulario controlado"@es ;
    skos:inScheme <https://w3id.org/medellin/espacio-publico/core/rule-names> ;
    skos:topConceptOf <https://w3id.org/medellin/espacio-publico/core/rule-names> .

:FormatRule a skos:Concept ;
    skos:prefLabel "Format Rule"@en ;
    skos:prefLabel "Regla de Formato"@es ;
    skos:definition "Rule that validates syntactic format patterns (regex, type constraints)"@en ;
    skos:definition "Regla que valida patrones de formato sintactico (regex, restricciones de tipo)"@es ;
    skos:inScheme <https://w3id.org/medellin/espacio-publico/core/rule-names> ;
    skos:topConceptOf <https://w3id.org/medellin/espacio-publico/core/rule-names> .

:RegulacionVocabularyRule a skos:Concept ;
    skos:prefLabel "Regulacion Vocabulary Rule"@en ;
    skos:prefLabel "Regla de Vocabulario de Regulacion"@es ;
    skos:definition "Vocabulary rule specific to the vendor regulation (regulados) procedure"@en ;
    skos:definition "Regla de vocabulario especifica para el procedimiento de regulacion de vendedores informales"@es ;
    skos:scopeNote "Sourced from regulacion_v1 DMP tentative a2_listas"@en ;
    skos:inScheme <https://w3id.org/medellin/espacio-publico/core/rule-names> ;
    skos:topConceptOf <https://w3id.org/medellin/espacio-publico/core/rule-names> .

:RegulacionFormatRule a skos:Concept ;
    skos:prefLabel "Regulacion Format Rule"@en ;
    skos:prefLabel "Regla de Formato de Regulacion"@es ;
    skos:definition "Format rule specific to the vendor regulation (regulados) procedure"@en ;
    skos:definition "Regla de formato especifica para el procedimiento de regulacion de vendedores informales"@es ;
    skos:scopeNote "Sourced from regulacion_v1 DMP tentative a3_formatos"@en ;
    skos:inScheme <https://w3id.org/medellin/espacio-publico/core/rule-names> ;
    skos:topConceptOf <https://w3id.org/medellin/espacio-publico/core/rule-names> .


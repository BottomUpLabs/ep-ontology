    skos:prefLabel "PR-GGOL-011 - Intervencion del espacio publico"@es ;
    skos:notation "PR-GGOL-011" ;
    skos:scopeNote "Procedimiento operativo de intervencion y recuperacion del espacio publico."@es .

vocab:pr-ggol-012 a skos:Concept ;
    skos:inScheme vocab:normograma ; skos:broader vocab:procedimiento-interno ;
    skos:prefLabel "PR-GGOL-012 - Novedades de venteros regulados"@es ;
    skos:notation "PR-GGOL-012" ;
    skos:scopeNote "Procedimiento para gestionar novedades de vendedores regulados."@es .

vocab:pr-ggol-019 a skos:Concept ;
    skos:inScheme vocab:normograma ; skos:broader vocab:procedimiento-interno ;
    skos:prefLabel "PR-GGOL-019 - Aprovechamiento economico"@es ;
    skos:notation "PR-GGOL-019" ;
    skos:scopeNote "Procedimiento de autorizacion del aprovechamiento economico del espacio publico."@es .

vocab:pr-ggol-020 a skos:Concept ;
    skos:inScheme vocab:normograma ; skos:broader vocab:procedimiento-interno ;
    skos:prefLabel "PR-GGOL-020 - Publicidad exterior visual"@es ;
    skos:notation "PR-GGOL-020" ;
    skos:scopeNote "Procedimiento de registro, verificacion y control de publicidad exterior visual."@es .

vocab:de-ggol-007 a skos:Concept ;
    skos:inScheme vocab:normograma ; skos:broader vocab:procedimiento-interno ;

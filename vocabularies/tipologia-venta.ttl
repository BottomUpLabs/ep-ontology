@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vocab: <https://w3id.org/medellin/espacio-publico/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# =============================================================================
# VOCABULARIO CONTROLADO: Tipologia de Venta Informal
# =============================================================================
# Vocabulario SKOS jerarquico que clasifica los tipos de productos y servicios
# ofrecidos por vendedores informales. Incluye sinonimos para limpieza de datos.
# Reemplaza la tabla a2_listas.tipologia_venta_v1 del DMP.
# =============================================================================

vocab:tipologia-venta a skos:ConceptScheme ;
    owl:versionInfo "0.1.0" ;
    dcterms:publisher <https://w3id.org/medellin/espacio-publico/agent/subsecretaria-espacio-publico> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:issued "2026-05-31"^^xsd:date ;
    bibo:status "published"@en ;
    dcterms:title "Tipologia de Venta Informal"@es ;
    dcterms:title "Informal Sales Typology"@en ;
    dcterms:description """Vocabulario controlado jerarquico para clasificar los tipos
    de productos y servicios comercializados por vendedores informales en el espacio
    publico de Medellin. Organizado en categorias principales con subcategorias
    especificas. Incluye sinonimos para normalizacion automatica."""@es ;
    dcterms:creator "Subsecretaria de Espacio Publico" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-01-06"^^xsd:date ;
    dcterms:source "FO-GGOL-048 - Formulario de caracterizacion" ;
    prov:wasDerivedFrom <duckdb:///warehouses/raw_catalog.db#a2_listas.tipologia_venta_v1> ;
    skos:hasTopConcept
        vocab:alimentos-bebidas ,
        vocab:variedades ,
        vocab:servicios ,
        vocab:artesanias-manualidades .

# =============================================================================
# CATEGORIA PRINCIPAL: Alimentos y Bebidas
# =============================================================================

vocab:alimentos-bebidas a skos:Concept ;
    skos:inScheme vocab:tipologia-venta ;
    skos:prefLabel "Alimentos y bebidas"@es ;
    skos:prefLabel "Food and beverages"@en ;
    skos:altLabel "Comida"@es ;
    skos:altLabel "Alimentos"@es ;
    skos:notation "alimentos_bebidas" ;
    skos:definition "Venta de productos alimenticios preparados o sin preparar y bebidas"@es ;
    skos:topConceptOf vocab:tipologia-venta ;
    skos:narrower
        vocab:comidas-rapidas ,
        vocab:frutas-verduras ,
        vocab:bebidas ,
        vocab:dulces-confiteria ,
        vocab:panaderia ,
        vocab:helados .

# Subcategoria: Comidas Rapidas
vocab:comidas-rapidas a skos:Concept ;
    skos:inScheme vocab:tipologia-venta ;
    skos:prefLabel "Comidas rapidas"@es ;
    skos:altLabel "Comida rapida"@es ;
    skos:altLabel "Fast food"@en ;
    skos:notation "comidas_rapidas" ;
    skos:definition "Alimentos preparados para consumo inmediato: empanadas, arepas, hamburguesas, perros calientes, etc."@es ;
    skos:broader vocab:alimentos-bebidas ;
    skos:hiddenLabel "comida rapida"@es ;
    skos:hiddenLabel "hamburguesas"@es ;
    skos:hiddenLabel "perros calientes"@es ;
    skos:hiddenLabel "empanadas"@es ;
    skos:hiddenLabel "arepas"@es ;
